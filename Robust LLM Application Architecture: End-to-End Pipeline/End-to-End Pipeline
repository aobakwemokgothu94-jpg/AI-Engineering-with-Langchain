import datetime
import logging
from typing import Optional
from devtools import pprint
from langchain.chat_models import init_chat_model
from pydantic import BaseModel, Field, ValidationError
import openai

# Configure logging for monitoring & error tracking
logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
logger = logging.getLogger(__name__)


# ==========================================
# 1. DATA MODELING & SCHEMAS (Pydantic)
# ==========================================

class SubItem(BaseModel):
    name: str = Field(description="Sub-component or feature name")
    score: float = Field(gt=0, le=10, description="Rating or severity score between 0 and 10")
    note: Optional[str] = Field(default=None, description="Optional diagnostic note or context")


class TriageReport(BaseModel):
    report_id: str = Field(pattern=r"^[A-Z]\d{4}$", description="Unique report ID matching format like A1234")
    severity_level: str = Field(description="Overall severity: Low, Medium, High, or Critical")
    summary: str = Field(description="Brief, executive summary of the analyzed input")
    tags: list[str] = Field(description="Relevant technical or categorical tags")
    sub_items: list[SubItem] = Field(description="Detailed breakdown of identified components or findings")


# Input payload schema for pre-flight validation
class InputPayload(BaseModel):
    ticket_id: str = Field(pattern=r"^[A-Z]\d{4}$", description="Expected ticket ID format")
    timestamp: datetime.date = Field(description="Date of the event")
    content: str = Field(min_length=1, max_length=2000, description="Raw input text to process")


# ==========================================
# 2. INPUT VALIDATION & SANITIZATION
# ==========================================

def validate_incoming_payload(raw_json_data: str) -> Optional[InputPayload]:
    """
    Validates and sanitizes incoming payloads before they touch the LLM,
    protecting against token wastage, bad formats, and malformed structures.
    """
    try:
        validated_input = InputPayload.model_validate_json(raw_json_data)
        logger.info(f"Input payload {validated_input.ticket_id} successfully validated.")
        return validated_input
    except ValidationError as e:
        logger.error(f"Input validation failed: {e}")
        return None


# ==========================================
# 3. STRUCTURED LLM EXECUTION WITH ERROR HANDLING
# ==========================================

def process_with_llm(payload: InputPayload) -> Optional[TriageReport]:
    """
    Initializes a structured LLM client and executes the analysis pipeline
    wrapped with robust code-level error handling (timeouts, rate limits, server overloads).
    """
    try:
        # Initialize the chat model with LangChain
        llm = init_chat_model(model="gpt-4o", temperature=0)

        # Bind the Pydantic schema for guaranteed structured output parsing
        structured_llm = llm.with_structured_output(TriageReport)

        prompt = f"""
        Analyze the following incident ticket and generate a structured triage report:
        Ticket ID: {payload.ticket_id}
        Date: {payload.timestamp}
        Content: {payload.content}
        """

        logger.info("Sending request to LLM API...")
        # Invoke the structured model (with configurable timeout & retries parameters if supported)
        result = structured_llm.invoke(prompt)
        return result

    # Code-Level & API Error Handling Strategy
    except openai.APITimeoutError as e:
        logger.warning(f"Timeout (504) encountered: {e}. Consider reducing input size or increasing timeout limits.")
        # Graceful degradation fallback
        return None
    except openai.RateLimitError as e:
        logger.warning(f"Rate limit or Quota exceeded (429): {e}. Applying backoff/jitter protocol.")
        return None
    except openai.BadRequestError as e:
        logger.error(f"Invalid Request or Content Policy violation (400/413): {e}")
        return None
    except openai.APIConnectionError as e:
        logger.error(f"Server overload or network failure (503/529): {e}. Provider might be down.")
        return None
    except Exception as e:
        logger.critical(f"An unexpected error occurred during execution: {e}")
        return None


# ==========================================
# 4. EXECUTION DEMONSTRATION
# ==========================================

if __name__ == "__main__":
    # Sample incoming JSON payload
    sample_json = """
    {
      "ticket_id": "A1234",
      "timestamp": "2026-06-06",
      "content": "Critical alert: Database connection pool exhausted under high traffic spike. Latency spiked to 4500ms on primary endpoints. Recommendation: Scale connection pool max size and implement query caching."
    }
    """

    print("--- STEP 1: Pre-Flight Input Validation ---")
    clean_payload = validate_incoming_payload(sample_json)

    if clean_payload:
        print(f"Validated Ticket ID: {clean_payload.ticket_id}")
        print(f"Validated Date: {clean_payload.timestamp}")

        print("\n--- STEP 2: Structured LLM Execution ---")
        report = process_with_llm(clean_payload)

        if report:
            print("\n--- STEP 3: Validated Structured Output Result ---")
            pprint(report)
            
            # Direct field access demonstration
            print(f"\nReport ID: {report.report_id}")
            print(f"Severity: {report.severity_level}")
            print(f"Total Sub-items Analyzed: {len(report.sub_items)}")
        else:
            print("Processing failed gracefully due to an API or execution error.")
    else:
        print("Pipeline halted: Input payload failed validation rules.")

