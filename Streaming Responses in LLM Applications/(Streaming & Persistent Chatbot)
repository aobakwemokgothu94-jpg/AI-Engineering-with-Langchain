def stream_message_handler(self, user_message: str, history: list):
    """Send message to chatbot and stream the response live."""
    if not (user_message := user_message.strip()):
        yield "", history
        return

    # Append user prompt and empty assistant placeholder
    history.append(gr.ChatMessage(content=user_message, role="user"))
    history.append(gr.ChatMessage(content="", role="assistant"))
    yield "", history

    # Consume chunks from the generator and update UI view dynamically
    full_response = ""
    for chunk in self.diet_chatbot.stream_response(user_message):
        full_response += chunk
        history[-1] = gr.ChatMessage(content=full_response, role="assistant")
        yield "", history
