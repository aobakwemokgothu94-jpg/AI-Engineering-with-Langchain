Run the RAG pipeline script:

Bash
python rag.py
Example Code (rag.py)
Python
from langchain_community.vectorstores import FAISS
from langchain.chat_models import init_chat_model
from langchain_openai import OpenAIEmbeddings
from langchain_core.prompts import PromptTemplate
from dotenv import load_dotenv
import textwrap

load_dotenv()

# 1. Load FAISS Vector Store
vector_store_path = "data/retrieval-augmented-generation/semantic-retrieval"
vector_store = FAISS.load_local(
    vector_store_path,
    embeddings=OpenAIEmbeddings(),
    allow_dangerous_deserialization=True,
)

# 2. Define Knowledge Retrieval Function
def retrieve_knowledge(input: dict, k=10) -> dict:
    return {
        "context": vector_store.similarity_search(input["question"], k=k),
        "question": input["question"],
    }

# 3. Load Prompt Template & Model
with open("prompt.md", "r") as f:
    prompt_template_str = f.read()

prompt = PromptTemplate(
    template=prompt_template_str, input_variables=["question", "context"]
)
model = init_chat_model(model="gpt-4o") # Update to your preferred active model

# 4. Build Pipeline & Execute
semantic_rag = retrieve_knowledge | (prompt | model)

question = "What is artificial intelligence?"
result = semantic_rag.invoke({"question": question})

for line in result.text.split("\n"):
    print(textwrap.fill(line, width=80) if line.strip() else "")
