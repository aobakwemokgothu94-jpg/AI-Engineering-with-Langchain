Once launched, open your browser at the local URL provided by Gradio (typically http://127.0.0.1:7860), enter any security term (e.g., privilege escalation, lateral movement), and click Submit to get an instant explanation.

Code Overview
Python
from dotenv import load_dotenv
from langchain.chat_models import init_chat_model
from langchain_core.prompts import PromptTemplate
import gradio as gr

# Load environment variables
load_dotenv()

# Define prompt template
prompt_template_str = """
Your task is to explain the security concept of **{input_text}** in a way that is:
1. Clear and intuitive
2. Concise (in under 100 words)
3. Tailored specifically to an IT and cybersecurity professional.
"""

prompt_template = PromptTemplate.from_template(prompt_template_str)
model = init_chat_model("gpt-4o-mini", model_provider="openai")

# Wrapper function for Gradio
def generate_explanation(input_text: str) -> str:
    prompt = prompt_template.format(input_text=input_text)
    response = model.invoke(prompt)
    return response.text

# Build UI
demo = gr.Interface(
    fn=generate_explanation,
    inputs=[gr.Textbox(label="Security Term", lines=1)],
    outputs=[gr.Textbox(label="Explanation", lines=5)],
    flagging_mode="never",
    title="Security Term Explainer",
    description="Get a plain-language explanation of a security term"
)

if __name__ == "__main__":
    demo.launch()
